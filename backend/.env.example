# Copy to .env and adjust for your machine.
ENV=development

# postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/windup
DB_ECHO=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-really
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# The judge. "wasm" is the sandbox; "subprocess" does not sandbox and is
# development-only and Python-only.
JUDGE_RUNNER=wasm

# Which languages this deployment offers, in the order the workbench lists them.
# Each needs its WASI build fetched first, and the compiled three need a
# toolchain on the worker host:
#   ./scripts/fetch_language_wasm.sh
#   ./scripts/fetch_toolchains.sh
JUDGE_LANGUAGES=python,javascript,ruby,php,sql,cpp,rust,go
